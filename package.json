{
  "name": "contentful-broken-links",
  "version": "0.1.0",
  "private": true,
  "description": "Contentful app that finds published entries whose required link fields point to missing, archived, or unpublished targets.",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "create-app-definition": "contentful-app-scripts create-app-definition",
    "upload": "contentful-app-scripts upload --bundle-dir ./build"
  },
  "dependencies": {
    "@contentful/app-sdk": "^4.29.0",
    "@contentful/f36-components": "^4.74.0",
    "@contentful/f36-tokens": "^4.0.4",
    "@contentful/react-apps-toolkit": "^1.2.16",
    "contentful-management": "^11.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@contentful/app-scripts": "^2.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
